{
  "schemaVersion": 1,
  "id": "noscreenbobbing",
  "version": "${version}",

  "name": "No Screen Bobbing",
  "description": "Remove view bobbing's screen shake while keeping hand bobbing.",
  "authors": [
    "inboundbark"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/viewbobbingmod",
    "sources": "https://github.com/inboundbark/viewbobbingmod",
    "issues": "https://github.com/inboundbark/viewbobbingmod/issues"
  },

  "license": "MIT",
  "icon": "assets/noscreenbobbing/icon.png",

  "environment": "*",
  "entrypoints": {
    "stationapi:event_bus": [
      "io.github.inboundbark.noscreenbobbing.events.init.InitListener"
    ],
    "stationapi:event_bus_client": [
    ],
    "stationapi:event_bus_server": [
    ]
  },
  "mixins": [
    "noscreenbobbing.mixins.json"
  ],

  "depends": {
    "minecraft": "1.0.0-beta.7.3"
  },

  "custom": {
    "modmenu:clientsideOnly": true
  }
}
